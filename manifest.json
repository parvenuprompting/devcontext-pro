{
  "manifest_version": 3,
  "name": "DevContext Pro",
  "version": "1.3.0",
  "description": "Premium developer tool for extracting clean DOM context and component structures",
  "author": "Tiëndo Welles",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open DevContext Pro Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/utils.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "activate-scraper": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Start element selection"
    },
    "toggle-multi-select": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Toggle multi-select mode"
    }
  }
}